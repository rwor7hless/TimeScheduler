DATABASE_URL=postgresql+asyncpg://ts_user:your_password@localhost:5432/timescheduler
SECRET_KEY=generate-with-openssl-rand-hex-32
USER_LOGIN=Wor7hless
USER_PASSWORD=your_secure_password
JWT_ALGORITHM=HS256
# 30 days — single-user app; нет flow с refresh-токеном
JWT_EXPIRE_MINUTES=43200

BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=./backups
# Set to true for one-time DB reset (truncate all, create fresh admin). Set false after.
CLEAN_DB_ON_STARTUP=false

# JSON-массив или CSV. Для локалки хватит дефолта.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

USER_TIMEZONE=Europe/Moscow

# Telegram bot token from BotFather (leave empty to disable TG integration)
TELEGRAM_BOT_TOKEN=

# GigaChat (cloud.ru foundation-models) для daily tip и weekly report.
# Пусто — LLM-фичи отключены полностью, cron не регистрируется.
GIGACHAT_API_KEY=

# ntfy.sh push-уведомления (опционально)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
