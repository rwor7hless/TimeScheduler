# syntax=docker/dockerfile:1.6

# ---------- Builder ----------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy manifests first (leverage layer cache)
COPY package*.json ./
# Copy prisma schema if present (safe no-op if directory does not exist yet)
COPY prisma ./prisma/

RUN npm ci

# Copy the rest of the source
COPY . .

# Generate Prisma client (no-op safe if no schema yet)
RUN npm run prisma:generate || true

# Build the Nest app (produces dist/main.js)
RUN npm run build

# ---------- Runner ----------
FROM node:20-alpine AS runner

WORKDIR /app

# postgresql-client provides pg_dump for future backup logic
RUN apk add --no-cache postgresql-client

ENV NODE_ENV=production

# Copy built output + production node_modules from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

EXPOSE 4000

CMD ["node", "dist/main.js"]
