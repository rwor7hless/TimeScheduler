# syntax=docker/dockerfile:1.6

# ---------- Builder ----------
FROM node:20-alpine AS builder

WORKDIR /app

# openssl + libc6-compat let Prisma's engine detect OpenSSL 3.x on Alpine.
# Without them, prisma generate / runtime loader falls back to the
# OpenSSL 1.1 engine and crashes with "libssl.so.1.1: not found".
RUN apk add --no-cache openssl libc6-compat

# Copy manifests first (leverage layer cache)
COPY package*.json ./
# Copy prisma schema if present (safe no-op if directory does not exist yet)
COPY prisma ./prisma/

RUN npm ci

# Copy the rest of the source
COPY . .

# Generate Prisma client (no-op safe if no schema yet)
RUN npm run prisma:generate

# Build the Nest app (produces dist/main.js)
RUN npm run build

# ---------- Runner ----------
FROM node:20-alpine AS runner

WORKDIR /app

# openssl + libc6-compat so Prisma can dlopen libssl.so.3 at runtime;
# postgresql-client provides pg_dump for the backup endpoint.
RUN apk add --no-cache openssl libc6-compat postgresql-client

ENV NODE_ENV=production

# Copy built output + production node_modules from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
# Prisma schema + migrations must be present at runtime so
# `prisma migrate deploy` (run below) can apply them against the DB.
COPY --from=builder /app/prisma ./prisma

EXPOSE 4000

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
