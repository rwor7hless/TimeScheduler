# All TimeScheduler env keys live in the repo-root .env (one level up). This file is a reference map:
# Reuses repo root .env (one level up). Keys in use:
# DATABASE_URL=postgresql+asyncpg://ts_user:password@localhost:5432/timescheduler    # Python/asyncpg form
# DATABASE_URL_PRISMA=postgresql://ts_user:password@localhost:5432/timescheduler     # Prisma form (no +asyncpg)
# SECRET_KEY=...
# USER_LOGIN=Wor7hless
# USER_PASSWORD=...
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=43200
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=./backups
# CLEAN_DB_ON_STARTUP=false
# CORS_ORIGINS=*
# USER_TIMEZONE=Europe/Moscow
# LLM_PROVIDER=gigachat
# GIGACHAT_API_KEY=
# NVIDIA_API_KEY=
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=    # NEW (Phase 9) — public base URL, enables webhooks
# TELEGRAM_WEBHOOK_SECRET= # NEW (Phase 9) — required if TELEGRAM_WEBHOOK_URL is set
# PORT=4000                # Node backend port during A/B (Python stays on 8000)
