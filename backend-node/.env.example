# All TimeScheduler env keys live in the repo-root .env (one level up).
# This file is a reference map of every key the Node runtime reads.
#
# Two DATABASE_URL_ keys coexist during the Python -> Node A/B period:
#   - DATABASE_URL        : Python/asyncpg dialect (postgresql+asyncpg://...)
#   - DATABASE_URL_PRISMA : Prisma form (plain postgresql://...)
# DATABASE_URL stays untouched for Python; the Node container overrides
# DATABASE_URL_PRISMA via docker-compose so Prisma talks to db:5432 inside
# the compose network. Locally (outside Docker) point it at localhost:5433
# — the db service now publishes that host port, replacing the Phase 1
# ts-pg-proxy socat hack.
#
# DATABASE_URL=postgresql+asyncpg://ts_user:password@localhost:5432/timescheduler
# DATABASE_URL_PRISMA=postgresql://ts_user:password@localhost:5433/timescheduler
# SECRET_KEY=...
# USER_LOGIN=Wor7hless
# USER_PASSWORD=...
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=43200
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=./backups
# CLEAN_DB_ON_STARTUP=false
# CORS_ORIGINS=*
# USER_TIMEZONE=Europe/Moscow
# LLM_PROVIDER=gigachat
# GIGACHAT_API_KEY=
# NVIDIA_API_KEY=
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=    # Phase 9 — public base URL, enables webhook mode
# TELEGRAM_WEBHOOK_SECRET= # Phase 9 — required if TELEGRAM_WEBHOOK_URL is set
# PORT=4000                # Node backend port during A/B (Python stays on 8000)
